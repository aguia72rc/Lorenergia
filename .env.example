# =====================================================================
# Configuração do Supabase
# Pegue estes valores em: Supabase > Project Settings > API
# =====================================================================

# URL do projeto (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon / public). Pode ser exposta no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role). NUNCA exponha no navegador!
# Usada apenas em ações do servidor (Server Actions / rotas de API).
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# WhatsApp (opcional - somente se usar a API Oficial da Meta)
# Por padrão o sistema usa links wa.me (gratuitos) e não precisa disto.
# =====================================================================
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
